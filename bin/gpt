#!/bin/sh
# Start an isolated router session with automatic approval review.
here="$(cd "$(dirname "$0")/.." && pwd)"
setup_home="${CODEX_HOME:-$HOME/.codex}"
if [ ! -f "$setup_home/gpt.config.toml" ]; then
    "$(command -v python3 || command -v python)" "$here/install.py" codex >/dev/null || exit $?
fi
export AGENT_ROLE=router CONTEXT_CAP_MAIN=185
exec codex --no-daemon --approve-for-me --profile gpt "$@"
